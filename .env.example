# ─────────────────────────────────────────────────────────
#  Maa-Web · env template
#  Copy this file to `.env` and tweak values as needed.
# ─────────────────────────────────────────────────────────

# ── Deployment version ──────────────────────────────────
# Bump on release. Images are tagged with this value.
MAAWEB_VERSION=latest

# ── Exposed port ────────────────────────────────────────
# Access URL: http://<your-nas-ip>:8080
# If your NAS already uses 8080 (e.g. QNAP default), change to another port.
MAAWEB_EXPOSE_PORT=8080

# ── Python runtime ──────────────────────────────────────
PYTHON_VERSION=3.12

# ── Logging ─────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
MAAWEB_LOG_LEVEL=INFO

# ── Security ────────────────────────────────────────────
# Single-user bearer token.
# Strongly RECOMMENDED to set your own long random string on NAS exposed to LAN.
# Leave empty to auto-generate at startup (printed to api container log once).
MAAWEB_SECRET_KEY=please-change-me-to-a-long-random-string-32chars-min

# ── 资源/引擎包下载 ─────────────────────────────────────
# MAA 发布资产平台：win-x64 | win-arm64 | linux-x86_64 | linux-aarch64
#MAAWEB_RESOURCE_PLATFORM=linux-x86_64
# GitHub 访问不稳定时可配置多个 ghproxy 类镜像前缀（逗号分隔），
# 用法为「前缀 + 完整 GitHub URL」。客户端并发 HEAD 测速择优，失败自动切换；
# 留空 = 官方 GitHub 直连。
#MAAWEB_RESOURCE_MIRROR=https://ghproxy.net/,https://ghfast.top/,https://mirror.ghproxy.com/

# ── 时区 ────────────────────────────────────────────────
# 容器本地时区：日志按天归档、定时执行（星期×时间）、主题日出日落均依赖。
# 用 tz database 名称（Asia/Shanghai / America/New_York 等）。
TZ=Asia/Shanghai

# ── 设备接入（容器内已装 adb） ─────────────────────────
# 网络 ADB 连接局域网设备；默认 /usr/bin/adb，一般无需修改。
#MAAWEB_ADB_PATH=/usr/bin/adb
